+#!/bin/bash
+set -e
+
+./node_modules/.bin/nearleyc src/parser/grammar.ne -o src/parser/grammar.ts
+
+MODE="${1:-base}"
+
+if [ "$MODE" = "base" ]; then
+  npx jest --testPathIgnorePatterns='test/pipe-compound-phase-a.test.ts' --testPathIgnorePatterns='test/pipe-compound-phase-b.test.ts' --testPathIgnorePatterns='test/pipe-compound-phase-c.test.ts' --testPathIgnorePatterns='test/pipe-compound-phase-d.test.ts' --no-coverage
+elif [ "$MODE" = "phase-a" ]; then
+  npx jest test/pipe-compound-phase-a.test.ts --no-coverage
+elif [ "$MODE" = "phase-b" ]; then
+  npx jest test/pipe-compound-phase-b.test.ts --no-coverage
+elif [ "$MODE" = "phase-c" ]; then
+  npx jest test/pipe-compound-phase-c.test.ts --no-coverage
+elif [ "$MODE" = "phase-d" ]; then
+  npx jest test/pipe-compound-phase-d.test.ts --no-coverage
+else
+  echo "Usage: bash test.sh [base|phase-a|phase-b|phase-c|phase-d]"
+  exit 1
+fi
diff --git a/test/pipe-compound-phase-a.test.ts b/test/pipe-compound-phase-a.test.ts
