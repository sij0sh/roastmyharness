+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('Pipe Compound Phase C', () => {
+  const language = 'bigquery';
+  const format: FormatFn = (query, cfg = {}) => originalFormat(query, { ...cfg, language });
+
+  it('formats RENAME pipe clause', () => {
+    const result = format('FROM t |> RENAME a AS b');
+    expect(result).toBe(dedent`
+      FROM
+        t
+      |> RENAME
+        a AS b
+    `);
+  });
+
+  it('formats RENAME with multiple renames', () => {
+    const result = format('FROM t |> RENAME a AS b, c AS d');
+    expect(result).toBe(dedent`
+      FROM
+        t
+      |> RENAME
+        a AS b,
+        c AS d
+    `);
+  });
+
+  it('formats RENAME chained with other steps', () => {
+    const result = format('FROM t |> WHERE x > 1 |> RENAME a AS b |> SELECT b');
+    expect(result).toBe(dedent`
+      FROM
+        t
+      |> WHERE
+        x > 1
+      |> RENAME
+        a AS b
+      |> SELECT
+        b
+    `);
+  });
+
+  it('applies keywordCase lower to RENAME', () => {
+    const result = format('from t |> rename a as b', { keywordCase: 'lower' });
+    expect(result).toBe(dedent`
+      from
+        t
+      |> rename
+        a as b
+    `);
+  });
+
+  it('formats PIVOT pipe operator', () => {
+    const result = format('FROM Produce |> PIVOT (SUM(sales) FOR quarter IN (Q1, Q2, Q3, Q4))');
+    expect(result).toBe(dedent`
+      FROM
+        Produce
+      |> PIVOT (
+        SUM(sales)
+        FOR quarter IN (Q1, Q2, Q3, Q4)
+      )
+    `);
+  });
+
+  it('formats UNPIVOT pipe operator', () => {
+    const result = format('FROM Produce |> UNPIVOT (sales FOR quarter IN (Q1, Q2))');
+    expect(result).toBe(dedent`
+      FROM
+        Produce
+      |> UNPIVOT (
+        sales
+        FOR quarter IN (Q1, Q2)
+      )
+    `);
+  });
+
+  it('formats TABLESAMPLE SYSTEM pipe operator', () => {
+    const result = format('FROM dataset.my_table |> TABLESAMPLE SYSTEM (10 PERCENT)');
+    expect(result).toBe(dedent`
+      FROM
+        dataset.my_table
+      |> TABLESAMPLE SYSTEM (10 PERCENT)
+    `);
+  });
+
+  it('formats PIVOT chained with WHERE', () => {
+    const result = format('FROM Produce |> PIVOT (SUM(sales) FOR quarter IN (Q1, Q2)) |> WHERE Q1 > 0');
+    expect(result).toBe(dedent`
+      FROM
+        Produce
+      |> PIVOT (
+        SUM(sales)
+        FOR quarter IN (Q1, Q2)
+      )
+      |> WHERE
+        Q1 > 0
+    `);
+  });
+});
