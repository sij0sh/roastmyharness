+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('Pipe Compound Phase D', () => {
+  const language = 'bigquery';
+  const format: FormatFn = (query, cfg = {}) => originalFormat(query, { ...cfg, language });
+
+  it('formats RENAME inside a CTE body', () => {
+    const result = format('WITH x AS (FROM t |> RENAME a AS b) SELECT b FROM x');
+    expect(result).toBe(dedent`
+      WITH
+        x AS (
+          FROM
+            t
+          |> RENAME
+            a AS b
+        )
+      SELECT
+        b
+      FROM
+        x
+    `);
+  });
+
+  it('formats UNION ALL of RENAME queries', () => {
+    const result = format('FROM a |> RENAME x AS y UNION ALL FROM b |> RENAME x AS y');
+    expect(result).toBe(dedent`
+      FROM
+        a
+      |> RENAME
+        x AS y
+      UNION ALL
+      FROM
+        b
+      |> RENAME
+        x AS y
+    `);
+  });
+
+  it('formats CREATE VIEW AS with PIVOT', () => {
+    const result = format(
+      'CREATE VIEW v AS FROM Produce |> PIVOT (SUM(sales) FOR quarter IN (Q1, Q2))'
+    );
+    expect(result).toBe(dedent`
+      CREATE VIEW v AS
+      FROM
+        Produce
+      |> PIVOT (
+        SUM(sales)
+        FOR quarter IN (Q1, Q2)
+      )
+    `);
+  });
+
+  it('formats INSERT INTO with EXTEND chain', () => {
+    const result = format(
+      'INSERT INTO t (FROM orders |> EXTEND amount * 1.1 AS total |> SELECT total)'
+    );
+    expect(result).toBe(dedent`
+      INSERT INTO
+        t (
+          FROM
+            orders
+          |> EXTEND
+            amount * 1.1 AS total
+          |> SELECT
+            total
+        )
+    `);
+  });
+
+  it('substitutes params inside pipe chains', () => {
+    const result = format(
+      'FROM orders |> AGGREGATE SUM(amount) AS total GROUP BY customer_id |> WHERE total > ?',
+      { params: ['100'] }
+    );
+    expect(result).toBe(dedent`
+      FROM
+        orders
+      |> AGGREGATE
+        SUM(amount) AS total
+        GROUP BY
+          customer_id
+      |> WHERE
+        total > 100
+    `);
+  });
+
+  it('keeps line comments around EXTEND steps', () => {
+    const result = format('FROM t |> EXTEND a + b AS c -- computed\n|> WHERE c > 1');
+    expect(result).toBe(dedent`
+      FROM
+        t
+      |> EXTEND
+        a + b AS c -- computed
+      |> WHERE
+        c > 1
+    `);
+  });
+
+  it('formats JOIN with SET subquery', () => {
+    const result = format(
+      'FROM a |> JOIN (FROM b |> SET x = 1 |> SELECT x) AS bb ON a.id = bb.id'
+    );
+    expect(result).toBe(dedent`
+      FROM
+        a
+      |> JOIN (
+        FROM
+          b
+        |> SET
+          x = 1
+        |> SELECT
+          x
+      ) AS bb ON a.id = bb.id
+    `);
+  });
+
+  it('keeps standard pipe layout under tabularLeft', () => {
+    const result = format('FROM orders |> WHERE x = 1 |> SELECT a', {
+      indentStyle: 'tabularLeft',
+    });
+    expect(result).toBe(dedent`
+      FROM      orders
+      |> WHERE
+                x = 1
+      |> SELECT
+                a
+    `);
+  });
+
+  it('keeps standard pipe layout under tabularRight', () => {
+    const result = format('FROM orders |> WHERE x = 1 |> SELECT a', {
+      indentStyle: 'tabularRight',
+    });
+    expect(result).toBe(dedent`
+           FROM orders
+      |> WHERE
+                x = 1
+      |> SELECT
+                a
+    `);
+  });
+
+  it('keeps RENAME layout under tabularLeft', () => {
+    const result = format('FROM t |> RENAME a AS b |> LIMIT 5', {
+      indentStyle: 'tabularLeft',
+    });
+    expect(result).toBe(dedent`
+      FROM      t
+      |> RENAME
+                a AS b
+      |> LIMIT 5
+    `);
+  });
+});
